{"width": 1600, "height": 900, "record": true,
 "out": "out/whats_new",
 "shots": [
  {"name": "a_chamfer", "frames": 4, "do": [
    "file.new", "move:vp:0.5,0.5@1",
    "create.box:X=0,Y=0,Width=40,Depth=30,Height=20", "edit.clear", "view.iso:now", "view.fit", "wait:10",
    "say:New since 0.3.0. First: chamfers by two distances", "wait:45",
    "move:w:20,0,20@20", "wait:8", "click", "wait:10",
    "move:btn:feature.chamfer@20", "click", "wait:25",
    "feature.set:Type=Two distances", "wait:20",
    "move:prop:Distance@18", "click", "wait:3", "key:ctrl+a", "type:2", "key:enter", "wait:15",
    "move:prop:Distance 2@18", "click", "wait:3", "key:ctrl+a", "type:6", "key:enter", "wait:40",
    "say:Swap puts the long side on the other face", "feature.set:Swap=1", "wait:50",
    "say:...or a distance and an angle", "feature.set:Type=Distance and angle,Swap=0,Distance=6,Angle=20", "wait:55",
    "edit.clear", "move:vp:0.95,0.9@15", "wait:30"]},
  {"name": "b_sets", "frames": 4, "do": [
    "file.new", "create.box:X=0,Y=0,Width=40,Depth=30,Height=20", "edit.clear", "view.iso:now", "view.fit", "wait:10",
    "say:Rounds of different sizes in one fillet: round every edge 6 mm", "wait:30",
    "move:item:Box 1@20", "click", "wait:8",
    "move:btn:feature.fillet@20", "click", "wait:20",
    "move:prop:Radius@18", "click", "wait:3", "key:ctrl+a", "type:6", "key:enter", "wait:40",
    "say:Pick three upright rounds and give them a radius of their own", "wait:20",
    "move:w:38.24,1.76,10@18", "wait:6", "addclick", "wait:6",
    "move:w:1.17,1.17,10@18", "wait:6", "addclick", "wait:6",
    "move:w:38.83,28.83,10@18", "wait:6", "addclick", "wait:10",
    "move:btn:fillet.ownsize@20", "click", "wait:15",
    "move:prop:Radius 2@18", "click", "wait:3", "key:ctrl+a", "type:2", "key:enter", "wait:40",
    "say:Where small rounds meet larger ones the corners are mitred", "edit.clear",
    "move:w:40,0,20@20", "wheel:2@20", "wait:60"]},
  {"name": "c_chain", "frames": 4, "do": [
    "file.new", "create.box:X=0,Y=0,Width=40,Depth=30,Height=20", "edit.clear", "view.iso:now", "view.fit", "wait:10",
    "say:Tangent chains: round three uprights first", "wait:30",
    "move:w:40,0,10@18", "wait:6", "click", "wait:4",
    "move:w:0,0,10@18", "wait:6", "addclick", "wait:4",
    "move:w:40,30,10@18", "wait:6", "addclick", "wait:8",
    "move:btn:feature.fillet@20", "click", "wait:20",
    "move:prop:Radius@18", "click", "wait:3", "key:ctrl+a", "type:6", "key:enter", "wait:30", "edit.clear", "wait:10",
    "say:...then pick one top edge: the round runs on along every edge tangent to it", "wait:20",
    "move:w:20,0,20@20", "wait:8", "click", "wait:10",
    "move:btn:feature.fillet@20", "click", "wait:20",
    "move:prop:Radius@18", "click", "wait:3", "key:ctrl+a", "type:2", "key:enter", "wait:45",
    "edit.clear", "move:vp:0.95,0.9@15", "wait:40"]},
  {"name": "d_holes", "frames": 4, "do": [
    "file.new",
    "say:Screws (M20). A block with two holes made for an M5 screw", 
    "create.box:X=0,Y=0,Width=60,Depth=40,Height=15", "edit.clear", "view.iso:now", "view.fit", "wait:20",
    "sketch.xy", "wait:25",
    "move:btn:tool.point@15", "click", "wait:4",
    "move:sk:15,20@15", "sk.click", "wait:6", "move:sk:45,20@15", "sk.click", "wait:6",
    "move:btn:sketch.finish@15", "click", "wait:8", "move:item:Sketch 1@15", "click", "wait:4", "feature.set:Offset=15", "wait:10", "view.iso:now", "view.fit", "wait:20",
    "move:btn:feature.hole@20", "click", "wait:20",
    "say:Holes made for a screw: pick the size and fit, the sizes come from ISO 273 and DIN 974",
    "feature.set:Type=Counterbore,Extent=Through all", "wait:25",
    "feature.set:Screw=M5,Fit=Normal", "wait:80",
    "edit.clear", "move:vp:0.95,0.9@15", "wait:10"]},
  {"name": "e_screws", "frames": 4, "do": [
    "say:Select both rims and press Screw: a socket head screw goes into each", "wait:20",
    "move:w:15,25,15@20", "wait:8", "click", "wait:6", "hold:ctrl", "move:w:45,15,15@20", "wait:8", "click", "release:ctrl", "wait:10",
    "move:btn:assemble.screw@20", "click", "wait:50",
    "say:Each screw sits on its counterbore's floor (x-ray)", "edit.clear",
    "move:item:Box 1@18", "click", "view.xray:on", "wait:6", "edit.clear", "move:vp:0.95,0.9@15", "wait:60"]},
  {"name": "f_follow", "frames": 4, "do": [
    "say:The screws are jointed in their holes: make the block taller...",
    "move:item:Box 1@20", "click", "wait:6",
    "move:prop:Height@18", "click", "wait:3", "key:ctrl+a", "type:30", "key:enter", "wait:30",
    "say:...and raise the holes' sketch: the screws go with them",
    "move:item:Sketch 1@20", "click", "wait:6",
    "move:prop:Offset@18", "click", "wait:3", "key:ctrl+a", "type:30", "key:enter", "wait:50",
    "edit.clear", "view.fit", "move:vp:0.95,0.9@15", "wait:40"]},
  {"name": "g_turn", "frames": 4, "do": [
    "say:Each joint is revolute: its angle turns the screw in its hole",
    "move:step:ISO 4762 M5×16 in its hole@20", "click", "wait:15",
    "move:w:15,20,24.6@20", "wheel:4@20", "wait:10",
    "move:prop:Angle@18", "click", "wait:3", "key:ctrl+a", "type:30", "key:enter", "wait:40",
    "say:...or Play spins it", "move:btn:joint.play@18", "click", "wait:120", "click", "wait:15",
    "move:vp:0.5,0.5@10", "view.fit", "wait:20",
    "say:A screw's standard, size and length are in its properties",
    "move:item:ISO 4762 M5×16@20", "click", "wait:20",
    "wait:70",
    "say:", "edit.clear", "move:vp:0.95,0.9@15", "wait:30"]}
 ]}
