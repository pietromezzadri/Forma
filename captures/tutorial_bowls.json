{
  "width": 1600, "height": 900, "out": "out/tutorial_bowls", "record": true,
  "shots": [
    {"name": "g1_profile", "frames": 8, "do": [
      "file.new", "snap.step:1", "move:vp:0.5,0.5@1",
      "say:Part 1: a two-colour bowl. Sketch its profile on the XZ plane", "wait:30",
      "sketch.xz", "wait:30", "move:sk:36,40@12", "wheel:-2@12", "wait:10",
      "move:btn:tool.line@15", "click",
      "move:sk:0,0@18", "click",
      "move:sk:72,0@18", "click", "move:sk:60,80@18", "click", "move:sk:53,80@12", "click",
      "move:sk:53,45@14", "click", "move:sk:0,45@16", "click", "move:sk:0,0@14", "click", "key:escape", "wait:4",
      "move:btn:tool.select@12", "click", "view.fit", "wait:20",
      "say:A tapered cup, and a pocket for the steel bowl", "wait:30",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.iso", "wait:25",
      "say:Pick the profile and revolve it round the sketch's vertical axis",
      "move:w:30,0,20@20", "wait:8", "click", "wait:6",
      "move:btn:feature.revolve@20", "click", "wait:25", "view.fit", "wait:30"
    ]},
    {"name": "g2_copy", "frames": 8, "do": [
      "say:Mirror the cup about YZ as a new body: a second copy, for the other colour",
      "move:w:0,-66,40@20", "wait:6", "click", "wait:6",
      "move:btn:feature.mirror@20", "click", "wait:10",
      "feature.set:Operation=New body", "wait:40"
    ]},
    {"name": "g3_wave", "frames": 8, "do": [
      "edit.clear", "say:Sketch the colour line: a slab whose top is four smooth spline spans", "wait:20",
      "sketch.xz", "wait:30", "view.fit", "wait:20", "move:sk:0,20@12", "wheel:-1@12", "wait:10",
      "move:btn:tool.line@15", "click",
      "move:sk:-96,-5@18", "click", "move:sk:96,-5@22", "click", "move:sk:96,26@14", "click", "key:escape", "wait:3",
      "move:btn:tool.spline@15", "click",
      "move:sk:96,26@12", "click", "move:sk:80,26@10", "click", "move:sk:64,36@10", "click", "move:sk:48,36@10", "click",
      "say:Each span after the first needs two clicks: its handle is mirrored, so the wave stays smooth",
      "move:sk:16,26@14", "click", "move:sk:0,26@10", "click",
      "move:sk:-32,36@14", "click", "move:sk:-48,36@10", "click",
      "move:sk:-80,26@14", "click", "move:sk:-96,26@10", "click", "key:escape", "wait:4",
      "move:btn:tool.line@15", "click", "move:sk:-96,26@12", "click", "move:sk:-96,-5@14", "click", "key:escape", "wait:10",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.front", "wait:25", "view.fit", "wait:20",
      "say:Extrude it both ways, 200 mm, as a new body",
      "move:w:88,0,10@20", "wait:8", "click", "wait:4",
      "move:btn:feature.extrude@18", "click", "wait:10",
      "feature.set:Direction=Symmetric,Operation=New body", "wait:6",
      "move:prop:Distance@18", "click", "wait:3", "key:ctrl+a", "type:200", "key:enter", "wait:20",
      "edit.clear", "view.iso", "wait:25", "view.fit", "wait:20"
    ]},
    {"name": "g4_combine", "frames": 8, "do": [
      "say:Combine: the copy minus the slab is the top (keep the slab for the next step)",
      "move:item:Mirror 1 #1@20", "click", "hold:ctrl", "move:item:Extrude 1@15", "click", "release:ctrl", "wait:6",
      "move:btn:feature.combine@20", "click", "wait:10",
      "feature.set:Operation=Cut,Keep tools=1", "wait:35",
      "say:...and the cup intersected with the slab is the base",
      "move:item:Revolve 1@20", "click", "hold:ctrl", "move:item:Extrude 1@15", "click", "release:ctrl", "wait:6",
      "move:btn:feature.combine@20", "click", "wait:10",
      "feature.set:Operation=Intersect", "wait:30", "edit.clear", "wait:10",
      "say:Two bodies now, meeting along the wave", "camto:30,-10", "wait:45"
    ]},
    {"name": "g5_holes", "frames": 8, "do": [
      "say:Hand holes: an oval slot on the YZ plane, two lines and two half circles",
      "sketch.yz", "wait:30", "view.fit", "wait:20", "move:sk:0,62@12", "wheel:3@12", "wait:10",
      "move:btn:tool.line@15", "click",
      "move:sk:-7,69@18", "click",
      "move:sk:7,69@14", "click", "key:escape",
      "move:sk:7,55@12", "click", "move:sk:-7,55@14", "click", "key:escape", "wait:4",
      "move:btn:tool.arc@15", "click",
      "move:sk:7,62@12", "click", "move:sk:7,55@10", "click", "move:sk:7,69@14", "click",
      "move:btn:tool.arc@15", "click",
      "move:sk:-7,62@12", "click", "move:sk:-7,69@10", "click", "move:sk:-7,55@14", "click", "wait:10",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.right", "wait:25", "view.fit", "wait:20",
      "say:X-ray the top so the slot can be picked through it",
      "move:w:61.2,0,72@18", "wait:5", "click", "wait:4", "move:btn:view.xray@18", "click", "wait:15",
      "move:w:0,0,62@18", "wait:6", "click", "wait:4",
      "say:Extrude it both ways as a cut: through both walls",
      "move:btn:feature.extrude@18", "click", "wait:10",
      "feature.set:Direction=Symmetric,Operation=Cut", "wait:6",
      "move:prop:Distance@18", "click", "wait:3", "key:ctrl+a", "type:200", "key:enter", "wait:20",
      "edit.clear", "move:w:61.2,0,72@18", "wait:5", "click", "wait:4", "view.xray:off", "wait:6", "edit.clear",
      "view.iso", "wait:30"
    ]},
    {"name": "g6_name", "frames": 8, "do": [
      "say:The name: pick the cone at the front and sketch on it, where it was clicked",
      "view.front", "wait:25", "view.fit", "wait:15",
      "move:w:0,-62.7,62@20", "wait:6", "click", "wait:4",
      "move:btn:sketch.face@18", "click", "wait:30",
      "move:btn:tool.text@15", "click", "move:sk:0,-8@15", "wait:3", "click", "wait:6",
      "text.set:GUTA", "text.size:20", "text.align:centre", "wait:20",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.front", "wait:25",
      "say:Emboss: raise it 1.2 mm on the cone, wrapped round it",
      "move:item:Sketch 4@18", "click", "wait:4",
      "move:w:-32.3,-55.9,50@18", "wait:5", "addclick", "wait:4",
      "move:btn:feature.emboss@18", "click", "wait:15",
      "feature.set:Type=Raise,Wrap=1", "wait:6",
      "move:prop:Depth@18", "click", "wait:3", "key:ctrl+a", "type:1.2", "key:enter", "wait:30",
      "edit.clear", "camto:60,-14", "wait:45"
    ]},
    {"name": "g7_done", "frames": 8, "do": [
      "say:Done: a base and a top, to print in two colours", "move:vp:0.98,0.98@10",
      "camto:120,-12", "wait:50", "camto:-40,-16", "wait:50", "say:", "wait:10"
    ]},
    {"name": "a1_bulb", "frames": 8, "do": [
      "file.new", "snap.step:1", "edit.clear", "move:vp:0.5,0.5@10",
      "say:Part 2: a ribbed bowl. Its outside is one spline", "wait:30",
      "sketch.xz", "wait:30",
      "move:sk:40,28@12", "wheel:-2@12", "wait:10",
      "move:btn:tool.line@15", "click", "move:sk:0,0@18", "click",
      "move:sk:62,0@18", "click", "key:escape",
      "move:btn:tool.spline@15", "click",
      "move:sk:62,0@14", "click", "move:sk:84,10@14", "click", "move:sk:82,42@14", "click", "move:sk:62,55@14", "click", "key:escape", "wait:4",
      "move:btn:tool.line@15", "click",
      "move:sk:62,55@14", "click", "move:sk:52,55@12", "click", "move:sk:52,25@14", "click",
      "move:sk:0,25@14", "click", "move:sk:0,0@12", "click", "key:escape", "wait:10",
      "say:Revolve it, as before",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.iso", "wait:25",
      "move:w:30,0,12@20", "wait:8", "click", "wait:6",
      "move:btn:feature.revolve@20", "click", "wait:25", "view.fit", "wait:30"
    ]},
    {"name": "a2_name", "frames": 8, "do": [
      "say:The name, on the XZ plane in front of the bowl",
      "sketch.xz", "wait:30",
      "view.fit", "wait:20",
      "move:btn:tool.text@15", "click", "move:sk:0,16@18", "wait:3", "click", "wait:6",
      "text.set:ARA", "text.size:22", "text.align:centre", "wait:20",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.front", "wait:25", "view.fit", "wait:15",
      "say:Emboss: raise it 4 mm on the bulb (the ribs will come up to 3 mm)",
      "move:item:Sketch 2@18", "click", "wait:4",
      "move:w:-30,-72.5,44@18", "wait:5", "addclick", "wait:4",
      "move:btn:feature.emboss@18", "click", "wait:15",
      "feature.set:Type=Raise", "wait:6",
      "move:prop:Depth@18", "click", "wait:3", "key:ctrl+a", "type:4", "key:enter", "wait:30",
      "edit.clear", "camto:60,-14", "wait:40"
    ]},
    {"name": "a3_rib", "frames": 8, "do": [
      "say:One rib on XZ: its outer edge is the bulb's spline with its points pushed out",
      "sketch.xz", "wait:30",
      "view.fit", "wait:20", "move:sk:70,28@12", "wheel:2@12", "wait:10",
      "move:btn:tool.line@15", "click", "move:sk:56,2@18", "click",
      "move:sk:65,2@14", "click", "key:escape",
      "move:btn:tool.spline@15", "click",
      "move:sk:65,2@14", "click", "move:sk:88,11@14", "click", "move:sk:86,42@14", "click", "move:sk:65,53@14", "click", "key:escape", "wait:4",
      "move:btn:tool.line@15", "click",
      "move:sk:65,53@14", "click", "move:sk:56,53@12", "click", "move:sk:56,2@14", "click", "key:escape", "wait:10",
      "say:The inner edge is buried in the wall, so the rib fuses with the bowl",
      "wait:25",
      "move:btn:sketch.finish@18", "click", "wait:10", "view.front", "wait:25", "view.fit", "wait:15",
      "say:Extrude it 2.4 mm thick, joined to the bowl",
      "move:w:79.6,0,26.4@20", "wheel:4@15", "wait:8", "move:w:79.6,0,26.4@6", "wait:4", "click", "wait:6",
      "move:btn:feature.extrude@18", "click", "wait:10",
      "feature.set:Direction=Symmetric,Operation=Join", "wait:6",
      "move:prop:Distance@18", "click", "wait:3", "key:ctrl+a", "type:2.4", "key:enter", "wait:25",
      "view.iso", "wait:25", "view.fit", "wait:25"
    ]},
    {"name": "a4_pattern", "frames": 8, "do": [
      "say:Circular pattern of the rib: 36 round the axis",
      "move:btn:feature.circular@18", "click", "wait:15",
      "move:prop:Count@18", "click", "wait:3", "key:ctrl+a", "type:36", "key:enter", "wait:40",
      "edit.clear", "move:vp:0.98,0.98@10", "view.fit", "wait:20", "camto:60,-14", "wait:40"
    ]},
    {"name": "a5_done", "frames": 8, "do": [
      "say:Done: the ribs follow the bulb's curve and the name stands proud of them",
      "camto:100,-10", "wait:50", "camto:20,-25", "wait:50", "say:", "wait:15"
    ]}
  ]
}
